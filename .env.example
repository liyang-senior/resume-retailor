# AI (at least one provider key required, OR set up chatgpt-session below).
# If OPENAI_API_KEY / ANTHROPIC_API_KEY are both unset, the app automatically
# uses the "chatgpt-session" provider (below) as the default — no manual
# selection needed as long as CHATGPT_SESSION_TOKEN is configured.
OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...

# Optional model overrides
# OPENAI_MODEL=gpt-5-mini
# ANTHROPIC_MODEL=claude-sonnet-4-5-20250929

# ChatGPT via your own browser session (provider "chatgpt-session") — no API
# key, no per-token billing. Calls ChatGPT's internal web endpoints using a
# copied session cookie, the same way your logged-in browser tab talks to
# chatgpt.com. OpenAI does not officially support automating this: it can be
# rate-limited or blocked without notice, and the token expires periodically
# (roughly every few weeks) — re-copy it whenever the provider starts
# failing with 401/403 errors. Use only with your own account.
#
# How to get CHATGPT_SESSION_TOKEN:
#   1. In a normal browser, log into https://chatgpt.com
#   2. Open DevTools (F12) > Application tab > Cookies > https://chatgpt.com
#   3. Copy the VALUE of the cookie named __Secure-next-auth.session-token
#   4. Paste it below (it's a long string).
# CHATGPT_SESSION_TOKEN=eyJhbGciOi...
#
# Optional: force a specific ChatGPT web model slug (defaults to "auto",
# which uses whatever model your ChatGPT plan defaults to)
# CHATGPT_MODEL=auto

# URL access rules (JSON array). First matching matchSubstring wins.
# allowedProfileSlugs = keys in src/lib/profiles/registry.js
# showRightSidebar defaults to true when omitted
# Match is case-insensitive against the browser accessUrl
URL_ACCESS_RULES=[{"matchSubstring":"abcdefg","allowedProfileSlugs":["carlos","christoper","elvis","joshua"],"showRightSidebar":true}]
