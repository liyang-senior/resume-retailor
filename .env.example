# AI (at least one provider key required)
OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...

# Optional model overrides
# OPENAI_MODEL=gpt-5-mini
# ANTHROPIC_MODEL=claude-sonnet-4-5-20250929

# URL access rules (JSON array). First matching matchSubstring wins.
# allowedProfileSlugs = keys in src/lib/profiles/registry.js
# showRightSidebar defaults to true when omitted
# Match is case-insensitive against the browser accessUrl
URL_ACCESS_RULES=[{"matchSubstring":"YOUR_TOKEN_1","allowedProfileSlugs":["rahulmonga","ariel","ricardo"],"showRightSidebar":true},{"matchSubstring":"YOUR_TOKEN_2","allowedProfileSlugs":["rahulmonga"],"showRightSidebar":false}]
